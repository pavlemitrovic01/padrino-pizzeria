# Padrino Pizzeria — Environment variables
# Copy to .env.local and fill with real values. Never commit secrets.

# ========== Frontend (Vite / browser) ==========
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Optional: card payments (Bankart Payment.js)
# VITE_BANKART_PAYMENTJS_ENABLED=false
# VITE_BANKART_PAYMENTJS_PUBLIC_KEY=
# (VITE_CARD_PAYMENTS_ENABLED is deprecated — use BANKART_* pair above)

# Optional: override API base (e.g. for local dev)
# VITE_API_BASE_URL=

# ========== Vercel server (api/*) ==========
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# CORS allowlist — comma-separated production origins
# Required in production; all origins rejected if unset (see api/_shared/cors.ts)
# Vercel preview URLs are auto-allowed via VERCEL_URL (I2)
ALLOWED_ORIGINS=https://yoursite.com,https://www.yoursite.com

# Required: the kitchen's order messages. The handlers send them directly
# (api/_shared/telegram.ts, B24) — no webhook endpoint, no shared secret.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Bankart (required if card payments enabled)
BANKART_API_KEY=your-api-key
BANKART_API_USERNAME=your-username
BANKART_API_PASSWORD=your-password
BANKART_SHARED_SECRET=your-shared-secret

# Optional Bankart overrides
# BANKART_API_BASE_URL=https://gateway.bankart.si/api/v3
# BANKART_LANGUAGE=en
# BANKART_CALLBACK_MAX_SKEW_SECONDS=300
# BANKART_STATUS_MIN_INTERVAL_SECONDS=15

# Rate limiting (create-order, 10 requests / 60 s per IP). Without these
# create-order runs with NO limit (fail-open) — set them in Production.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Optional: break-glass admin fallback when admin_users table missing
# ADMIN_FALLBACK_EMAIL=

# Required in Production: base URL for the Bankart callback/return URLs. The Origin header is never used (B22); without this the request Host
# header is the fallback (fine for Preview, not relied on for Production).
PUBLIC_SITE_URL=https://yoursite.com

# No longer read (B24): TELEGRAM_WEBHOOK_SECRET, SUPABASE_PROJECT_REF,
# SUPABASE_ANON_KEY, PAYMENTS_EDGE_TOKEN — safe to delete from Vercel.
