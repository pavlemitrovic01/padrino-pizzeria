# Padrino Pizzeria — Environment variables
# Copy to .env.local and fill with real values. Never commit secrets.

# ========== Frontend (Vite / browser) ==========
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Optional: enable card payments
# VITE_CARD_PAYMENTS_ENABLED=false
# VITE_BANKART_PAYMENTJS_ENABLED=false
# VITE_BANKART_PAYMENTJS_PUBLIC_KEY=

# Optional: override API base (e.g. for local dev)
# VITE_API_BASE_URL=

# ========== Vercel server (api/*) ==========
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Optional: webhook secret for telegram/order notify
# TELEGRAM_WEBHOOK_SECRET=

# Bankart (required if card payments enabled)
BANKART_API_KEY=your-api-key
BANKART_API_USERNAME=your-username
BANKART_API_PASSWORD=your-password
BANKART_SHARED_SECRET=your-shared-secret

# Optional Bankart overrides
# BANKART_API_BASE_URL=https://gateway.bankart.si/api/v3
# BANKART_LANGUAGE=en
# BANKART_CALLBACK_MAX_SKEW_SECONDS=300
# BANKART_STATUS_MIN_INTERVAL_SECONDS=15

# Rate limiting (create-order) — optional, fail-open if not set
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional: break-glass admin fallback when admin_users table missing
# ADMIN_FALLBACK_EMAIL=

# Optional: base URL for callbacks/redirects (default: from request)
# PUBLIC_SITE_URL=https://yoursite.com

# Optional: for payments-create-session edge function
# SUPABASE_PROJECT_REF=xxxxx
# SUPABASE_ANON_KEY=
# PAYMENTS_EDGE_TOKEN=
